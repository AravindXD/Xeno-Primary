# ============================================
# Frontend Environment Variables
# ============================================

# Backend API URL
# Default: http://localhost:5000/api
# Change this if your backend runs on a different port or domain
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Tenant ID to use for dashboard
# This should match the TENANT_ID you set in backend/.env
# Default: DEMO_TENANT_ID
NEXT_PUBLIC_TENANT_ID=DEMO_TENANT_ID

