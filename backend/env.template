# ============================================
# Database Configuration
# ============================================
# PostgreSQL connection string
# Format: postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE_NAME?schema=public
# Get this from your database provider (local PostgreSQL, Supabase, Railway, etc.)
DATABASE_URL="postgresql://postgres:password@localhost:5432/xeno_db?schema=public"

# ============================================
# Server Configuration
# ============================================
# Backend server port (optional, defaults to 5000)
PORT=5000

# ============================================
# Tenant Configuration (for seed script)
# ============================================
# TENANT_ID: Unique identifier for your tenant
#   - You create this yourself (NOT from Shopify)
#   - Can be any string: "DEMO_TENANT_ID", "store-001", or a UUID
#   - Generate UUID: node -e "console.log(require('crypto').randomUUID())"
#   - Default: "DEMO_TENANT_ID" if not set
TENANT_ID=DEMO_TENANT_ID

# STORE_NAME: Display name for your store (just a label, not from Shopify)
STORE_NAME=ara-test

# SHOPIFY_DOMAIN: Your Shopify store's myshopify.com domain
#   Where to get: Shopify Admin → Settings → Store details
#   Format: yourstore.myshopify.com
SHOPIFY_DOMAIN=ara-test.myshopify.com

# SHOPIFY_ACCESS_TOKEN: Admin API access token from Shopify
#   Where to get: Shopify Admin → Settings → Apps and sales channels → Develop apps
#   1. Create an app
#   2. Configure Admin API access scopes (read_customers, read_products, read_orders)
#   3. Install app and copy the access token (starts with shpat_)
#   ⚠️  WARNING: Never commit this to git!
SHOPIFY_ACCESS_TOKEN=your_shopify_access_token_here

